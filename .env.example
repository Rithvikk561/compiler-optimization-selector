# TOACD AI Coding Assistant Configuration (Architecture B+)
# Decoupled from the compiler pipeline. Purely advisory.

# Master Toggle: set false to completely disable the assistant endpoint
TOACD_ASSISTANT_ENABLED=true

# Provider Selection: mock | ollama | gemini | openai | anthropic
# Default: 'mock' (requires zero API keys, fully offline and deterministic)
TOACD_LLM_PROVIDER=mock

# Model Identifier Override (optional, defaults to canonical model per provider)
# - Gemini default: 'gemini-2.5-flash' (fallback: 'gemini-1.5-flash')
# - OpenAI default: 'gpt-4o-mini' (fallback: 'gpt-4o')
# - Anthropic default: 'claude-3-5-haiku-20241022' (fallback: 'claude-3-5-sonnet-20241022')
# - Ollama default: 'qwen2.5-coder:7b' (fallback: 'llama3.2:latest')
TOACD_LLM_MODEL=

# API Credentials (leave unset when using mock or local ollama)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Ollama Host (used when TOACD_LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# Privacy Policy Default: true allows cloud AI; false enforces strictly local offline
TOACD_EXTERNAL_AI_ALLOWED=true

# Rate Limiting: max assistant requests per minute per IP
TOACD_RATE_LIMIT_PER_MINUTE=10

# Generation Parameters
TOACD_LLM_MAX_TOKENS=1024
TOACD_LLM_TEMPERATURE=0.2
